# ---------------------------------------------------------------------------
# ezstack — local environment
#
#   cp .env.example .env.local
#
# `NEXT_PUBLIC_*` values are embedded at build time, so rebuild after changing.
# Convex deployment variables (BETTER_AUTH_SECRET, SITE_URL, ...) are set with
# `bunx convex env set` or the dashboard — see .env.convex.example.
# ---------------------------------------------------------------------------

# ---- Convex deployment ----------------------------------------------------
# `bunx convex dev` fills these in for a cloud dev deployment.

# Deployment used by `bunx convex dev` (cloud)
CONVEX_DEPLOYMENT=

# Public Convex API + HTTP-action URLs
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# ---- Site -----------------------------------------------------------------
# Public URL of the frontend.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Local self-hosted backend (optional) ---------------------------------
# Instead of a cloud dev deployment, run `docker compose up -d` and use:
#   CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
#   CONVEX_SELF_HOSTED_ADMIN_KEY=<from ./generate_admin_key.sh>
#   NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
#   NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211
