# ---------------------------------------------------------------------------
# Convex deployment environment variables.
#
# These live on the deployment, not in the frontend runtime. Set them with:
#
#   bunx convex env set --from-file .env.convex.local
#   # or: bunx convex env set BETTER_AUTH_SECRET "$(openssl rand -base64 32)"
#
# Never commit real values — this file is the committed template.
# ---------------------------------------------------------------------------

# Signs Better Auth tokens. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of the frontend. Drives Better Auth's baseURL and callbacks.
SITE_URL=http://localhost:3000

# Extra allowed browser origins, comma-separated. Feeds both the Convex HTTP
# CORS config and Better Auth trustedOrigins (see the CORS pass).
# Example: https://app.example.com,https://www.example.com
# CORS_ORIGINS=
